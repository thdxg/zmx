From 7556df4678b4d06ec58b441664041daa94783e1d Mon Sep 17 00:00:00 2001
From: Ethan Lee <ethantlee21@gmail.com>
Date: Mon, 21 Sep 2026 20:18:42 -0400
Subject: [PATCH] fix: keep the embedded Info.plist in release builds
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The first CI build of the disclaimed daemon shipped without its
__TEXT,__info_plist section: nothing reads the bytes at run time, and a
ReleaseSafe link dead-strips an export nothing references, while the
Debug builds the change was verified with kept it. Without the section
the daemon is a nameless responsible process — macOS has no bundle
identifier to record a Local Network grant against and no name for the
prompt. Reference the bytes from main() so every build keeps them.
---
 src/main.zig | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/main.zig b/src/main.zig
index 639cf83..c60a911 100644
--- a/src/main.zig
+++ b/src/main.zig
@@ -46,6 +46,7 @@ pub fn main(init: std.process.Init) !void {
     // write() can return BrokenPipe. Inherited across fork, so this also
     // covers the daemon.
     signal.ignoreSigpipe();
+    keepInfoPlist();
 
     var args = init.minimal.args.iterate();
     defer args.deinit();
@@ -571,6 +572,14 @@ comptime {
     }
 }
 
+/// Keeps the section in a release build. Nothing reads `info_plist` at run
+/// time, and a ReleaseSafe link dead-strips an export nothing references —
+/// the first CI build shipped without the section while a Debug build had
+/// it. Called from `main`, which is the one place every build reaches.
+fn keepInfoPlist() void {
+    if (builtin.os.tag.isDarwin()) std.mem.doNotOptimizeAway(&info_plist);
+}
+
 fn help(io: std.Io) !void {
     const help_text =
         \\zmx - session persistence for terminal processes
